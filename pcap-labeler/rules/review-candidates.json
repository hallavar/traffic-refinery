  "explicit_decisions": [
    {
      "application_id": "primevideo",
      "values": [
        "amazon.com",
        "images-eu.ssl-images-amazon.com",
        "images-na.ssl-images-amazon.com",
        "images-fe.ssl-images-amazon.com",
        "m.media-amazon.com"
      ],
      "decision": "exclude_as_standalone_evidence",
      "reason": "Broader Amazon commerce/assets scope. Their presence in a Prime Video page or routing list does not prove exclusive Prime Video use."
    },
    {
      "application_id": "primevideo",
      "values": [
        "avod.*s3.*-.*.akamaihd.net",
        "amazon.*.llwnd.net",
        "amazon.*.lldns.net",
        ".*eu.amazon.fr"
      ],
      "decision": "do_not_carry_forward",
      "reason": "Old regexes have unescaped dots, unbounded matching and weak current provenance; Amazon-branded names need not identify video."
    },
    {
      "application_id": "hulu",
      "values": [
        ".*hulu.*.akamaihd.net",
        ".*hulu.*.edgekey.net",
        ".*hulu.*.akadns.net"
      ],
      "decision": "replace_with_named_hosts",
      "reason": "Avoid arbitrary hostname substrings. Current known asset hosts and an observed branded CNAME are separately reviewable."
    },
    {
      "application_id": "hulu",
      "values": [
        "wildcard.hulu.com.edgekey.net"
      ],
      "decision": "hold_as_cname_context",
      "reason": "Observed from www.hulu.com, but do not blindly transfer classification through shared CDN IPs."
    },
    {
      "application_id": "hulu",
      "values": [
        "huluqa.com",
        "hulu.jp"
      ],
      "decision": "not_enabled",
      "reason": "QA/test scope and regional-service scope respectively need an explicit labeling decision."
    },
    {
      "application_id": "hulu",
      "values": [
        "disneyplus.com",
        "bamgrid.com",
        "bamgrid.net"
      ],
      "decision": "exclude_as_hulu_only_evidence",
      "reason": "The Hulu landing page redirected to Disney+ in this probe; cross-service redirects/assets must not all become Hulu labels."
    },
    {
      "application_id": "twitch",
      "values": [
        "live-video.net"
      ],
      "decision": "exclude_as_twitch_only_evidence",
      "sources": [
        "aws-ivs",
        "dlc-twitch",
        "ndpi"
      ],
      "reason": "AWS documents this namespace for general Amazon IVS. Both upstream lists include it under Twitch; that is insufficient for exclusive Twitch attribution."
    },
    {
      "application_id": "meet",
      "values": [
        "workspace.turns.goog"
      ],
      "decision": "hold_for_session_correlation",
      "sources": [
        "google-meet"
      ],
      "reason": "Google documents it for Workspace Meet media; the broader Workspace relay name warrants per-session evidence before exclusive application attribution."
    },
    {
      "application_id": "meet",
