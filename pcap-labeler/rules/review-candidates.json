        "ggpht.com"
      ],
      "decision": "exclude_as_standalone_meet_or_youtube_evidence",
      "reason": "Shared services or insufficiently specific namespace. Vendor firewall allowlists are connectivity requirements, not application-exclusive classifiers."
    },
