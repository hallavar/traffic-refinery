  "activity_policy": {
    "application_and_activity_are_independent": true,
    "inventory_category_is_flow_label": false,
    "hostname_only_traffic_category": "unknown",
    "browsing": "Search, comments, page navigation and other identified non-media web activity are browsing, even on a video service.",
    "video": "Reserve video for identified video media payload. Application membership, API traffic, thumbnails, manifests, subtitles, telemetry and transport overhead do not by themselves qualify.",
    "role_hints_are_labels": false,
    "role_hints": "DNS/SNI rules can suggest browsing_or_api, static_assets, telemetry, media_delivery_candidate or unknown. Hints are provisional and must not silently become traffic categories.",
    "uncertainty": "An application can be known while its traffic category remains unknown. Keep those records and their evidence.",
    "mixed_connections": "If a connection carries multiple activities, retain mixed or uncertain activity rather than marking all bytes video. Do not inherit video from another connection in the same session.",
    "byte_accounting": "Whole-flow byte totals are not video payload byte totals. Keep video_payload_bytes unset when encrypted or mixed traffic prevents reliable separation; never substitute total flow bytes.",
    "implementation_status": "Policy and rule hints only. There is no packet, request, stream or payload activity classifier yet."
  }
}
