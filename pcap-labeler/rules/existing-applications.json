{
  "schema_version": 2,
  "status": "research_draft_not_pcap_validated",
  "reviewed_on": "2026-10-21",
  "coverage": "Nine application entries already present in the video and VoIP configs. New inventory applications are outside this review.",
  "label_policy": {
    "unmatched_label": "unknown",
    "retain_unknown_flows": true,
    "conflict_label": "ambiguous",
    "first_match_wins": false
  },
  "matching_contract": {
    "input": "DNS question/original service hostname or TLS SNI; retain the evidence type in output.",
    "normalization": "ASCII DNS hostnames, case-insensitive, remove one optional terminal dot; reject URLs, IP literals, ports and malformed labels. Convert IDNs to ASCII before matching.",
    "domain_suffix": "host == domain or host.endswith(\".\" + domain)",
    "exact_hostname": "host == value; no automatic subdomain matching",
    "ip_prefixes": "No IP-prefix attribution in this pack; old ranges are not carried forward.",
    "dns_correlation": "A future flow labeler must scope DNS associations by client, answer chain, TTL and capture time, handle shared IPs, and avoid transferring one service label to unrelated flows sharing an IP.",
    "integration": "This is not a drop-in Traffic Refinery config. The legacy DomainsString matcher performs substring matching and cannot implement this contract. Schema v2 inventory_category is descriptive service metadata only. DNS/SNI matches identify an application and a provisional role hint; they cannot automatically output a video category."
  },
